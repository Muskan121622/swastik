# LLM provider (optional). Without it the agent fails CLOSED: every agent
# turn escalates to a human instead of guessing. Get a free key at console.groq.com
GROQ_API_KEY=
# Any tool-calling Groq model works. Verified with:
#   openai/gpt-oss-120b (default), openai/gpt-oss-20b
# If your account lacks these, list what you have:
#   python -c "from groq import Groq; print([m.id for m in Groq().models.list().data])"
GROQ_MODEL=openai/gpt-oss-120b

# Optional override; defaults to sqlite:///backend/data/clinic.db
# DATABASE_URL=sqlite:///data/clinic.db

# Deployment only (the Docker image reads these; leave unset for local dev):
#   PORT         injected by the platform (Render/heroku). uvicorn binds to it.
#   DATABASE_URL point at a mounted volume so the sqlite file survives
#                restarts, e.g. sqlite:////render/clinic.db with a disk at /render
# PORT=8000
# DATABASE_URL=sqlite:////render/clinic.db
