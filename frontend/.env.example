# Frontend API base URL.
#
# Local dev: leave empty — vite proxies /api -> http://127.0.0.1:8005
#            (see vite.config.ts), so the app works with the backend running.
#
# Split deploy (frontend on Vercel, backend on Render): set to the Render API
# origin. This is a BUILD-TIME variable (Vite inlines VITE_* into the bundle),
# so it must be configured in the Vercel project settings before building.
# VITE_API_URL=https://swasthiq-api.onrender.com
